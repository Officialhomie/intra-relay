# Copy this file to `.env.local` and fill in real values for local development.
# Do not commit `.env.local`. Only non-secret placeholders belong in this file.

# Public base URL of the app (used for absolute links / metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Human-readable environment label shown in non-production builds.
NEXT_PUBLIC_APP_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL UNSET for local development: the app and the db:* scripts
# use an embedded PostgreSQL (PGlite) stored in ./.pglite (git-ignored).
# Set it to a real PostgreSQL server for staging/production, then run
# `npm run db:migrate` in the deploy pipeline (migrations never run at request time).
# DATABASE_URL=postgres://user:password@host:5432/intra

# Optional: override the embedded PGlite data directory.
# PGLITE_DATA_DIR=./.pglite

# ---------------------------------------------------------------------------
# Operator authentication
# ---------------------------------------------------------------------------
# Comma-separated "label:secret" pairs. An operator presents the secret in the
# `x-operator-key` header. Required to verify/activate a route (PATCH
# /api/routes/:id/status -> ACTIVE) and to record a quote response.
# With none configured, no request can act as an operator.
# OPERATOR_API_KEYS=alice:change-me-locally,bob:change-me-too

# ---------------------------------------------------------------------------
# Celo x402 agent payments  (see docs/PAYMENTS.md — ADR-004, ADR-011)
# ---------------------------------------------------------------------------
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Leave X402_API_KEY unset and the
# quote endpoint returns PAYMENT_SERVICE_UNAVAILABLE — no 402, no fabricated
# settlement, receipt, or tx hash. Free routes and the buyer web flow are
# unaffected. A malformed X402_NETWORK / X402_ASSET / X402_ATTRIBUTION_TAG is
# logged once and degrades to the same unavailable state — it never crashes the
# quote workflow.
#
# X402_API_KEY: the metering key from the dashboard at https://x402.celo.org
#   (connect wallet -> Create API key -> sign; shown once). Gates POST /settle.
# X402_API_KEY=
#
# X402_NETWORK: CAIP-2 id. Default eip155:42220 (Celo Mainnet).
#   Celo Sepolia is eip155:11142220.
# X402_NETWORK=eip155:42220
#
# X402_ASSET: USDC (default) or USDT. USDT is mainnet-only.
# X402_ASSET=USDC
#
# X402_FACILITATOR_URL: optional override. Defaults per network:
#   mainnet  https://api.x402.celo.org
#   sepolia  https://api.x402.sepolia.celo.org
# X402_FACILITATOR_URL=
#
# X402_ATTRIBUTION_TAG: the ERC-8021 `celo_...` tag from official hackathon
#   registration (/^celo_[A-Za-z0-9][A-Za-z0-9_-]{2,62}$/). Only set once you
#   have it — it is recorded on receipts. A value that does not match the shape
#   is ignored with a logged warning, never recorded.
# X402_ATTRIBUTION_TAG=

# The task-level spending cap ($0.05) is a hard product rule, not an env var.
